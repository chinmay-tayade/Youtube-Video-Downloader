<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    tools:context=".Screens.InitialScreen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="36dp"
        android:paddingRight="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/tittle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/plusjakarta_sans_bold"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/plusjakarta_medium"
            android:text="@string/subtitle_message"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- YouTube link -->
        <TextView
            android:id="@+id/youtubeLinkTittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/plussansjakarta_semibold"
            android:text="@string/youtube_link"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/linkView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/link_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:id="@+id/pasteLink"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/paste_from_clipboard"
                android:src="@drawable/link_img" />

            <EditText
                android:id="@+id/editTextLink"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/plussansjakarta_semibold"
                android:hint="@string/paste_your_link_here"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/clear_text"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/clear"
                android:focusable="true"
                android:src="@drawable/cross_image" />
        </LinearLayout>

        <!-- Destination -->
        <TextView
            android:id="@+id/destinationTittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/plussansjakarta_semibold"
            android:text="@string/destination_folder"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RelativeLayout
            android:id="@+id/filePathView"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/link_background"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <ImageView
                android:id="@+id/folderIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="@string/destination_folder"
                android:src="@drawable/folder_image" />

            <TextView
                android:id="@+id/path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/folderIcon"
                android:ellipsize="start"
                android:fontFamily="@font/plussansjakarta_semibold"
                android:hint="@string/tap_to_choose_folder"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/infoView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/info_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/plusjakarta_medium"
                android:text="@string/info_message"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action -->
        <FrameLayout
            android:id="@+id/viewSwitcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_download"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/button_image"
                android:fontFamily="@font/plusjakarta_sans_bold"
                android:onClick="onButtonClick"
                android:text="@string/download"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="15sp" />

            <include
                layout="@layout/progressbutton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
